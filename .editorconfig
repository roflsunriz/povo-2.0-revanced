root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
ktlint_code_style = intellij_idea
ktlint_standard_no-wildcard-imports = disabled

[*.{java,xml,yml,yaml,md}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
